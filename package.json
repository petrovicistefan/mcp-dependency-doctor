{
  "name": "mcp-dependency-doctor",
  "version": "0.1.3",
  "description": "MCP server for npm dependency health: read-only inventory, npm audit vulnerabilities, outdated and deprecated packages. Never runs install. For Claude, Cursor, Codex.",
  "mcpName": "io.github.petrovicistefan/mcp-dependency-doctor",
  "type": "module",
  "bin": {
    "mcp-dependency-doctor": "src/server.js"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "start:hosted": "node --env-file=.env src/hosted.js",
    "test": "node --test test/*.test.js",
    "check": "node --check src/server.js && node --check src/doctor.js && node --check src/control-plane-client.js && node --check src/hosted.js && node --check src/version.js && node --check scripts/check-rules.mjs",
    "test:integration": "node test/mcp.integration.js",
    "check:rules": "node scripts/check-rules.mjs",
    "prepublishOnly": "npm run check && npm run check:rules && npm test && npm run test:integration"
  },
  "license": "MIT",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "npm",
    "dependencies",
    "dependency-audit",
    "npm-audit",
    "vulnerabilities",
    "outdated",
    "deprecated",
    "package-lock",
    "supply-chain",
    "read-only",
    "offline",
    "local-first",
    "ai-agents",
    "claude",
    "claude-code",
    "cursor",
    "codex",
    "copilot"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/petrovicistefan/mcp-dependency-doctor.git"
  },
  "homepage": "https://github.com/petrovicistefan/mcp-dependency-doctor#readme",
  "bugs": {
    "url": "https://github.com/petrovicistefan/mcp-dependency-doctor/issues"
  },
  "author": "Stefan Petrovici",
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.26.0"
  }
}
